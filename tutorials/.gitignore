# Fitted model objects are 190-320 MB each, almost all of it subject-level
# draws. They stay on the machine that fitted them; 03_compress.R turns them
# into the small artefacts under results/small/, which are committed.
results/*.rds
results/*.csv
results/*.txt

# The reduced bundle is the point of the exercise, so it is not ignored.
!results/small/

# Participant-level data is added deliberately, not by accident.
data/*.csv
